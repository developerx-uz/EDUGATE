# ==============================================================================
# EDUGATE Core Configuration (.env.example)
# Nusxa ko'chiring: cp .env.example .env
# ==============================================================================

# Asosiy sozlamalar
PROJECT_NAME="EDUGATE Attendance System"
VERSION="1.0.0"
DEBUG=True
API_V1_STR="/api/v1"
SECRET_KEY="change-this-to-a-very-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL ma'lumotlar bazasi
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=edugate_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}

# SQLite (Agar PostgreSQL o'rnatilmagan bo'lsa lokal test uchun zaxira)
USE_SQLITE=True
SQLITE_DB_PATH="./edugate_local.db"

# Redis (Debounce, Anti-passback va Kesh uchun)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
DEBOUNCE_MINUTES=15

# Telegram Bot sozlamalari
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_WEBHOOK_URL="https://your-domain.uz/webhook"

# Maktab va Dars vaqtlari
SCHOOL_START_TIME="08:00"
LATE_THRESHOLD_MINUTES=15
