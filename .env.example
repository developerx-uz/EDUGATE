PROJECT_NAME="EDUGATE Attendance System"
VERSION="1.0.0"
DEBUG=True
API_V1_STR="/api/v1"
SECRET_KEY="edugate-secret-key-production-2026-safe"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

POSTGRES_SERVER=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=edugate_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/edugate_db

USE_SQLITE=False
SQLITE_DB_PATH="./edugate_local.db"

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
DEBOUNCE_MINUTES=15

TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_WEBHOOK_URL="https://developerx.uz/edugate/webhook"

SCHOOL_START_TIME="08:00"
LATE_THRESHOLD_MINUTES=15
